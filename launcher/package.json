{
  "name": "webrpa-launcher",
  "version": "3.2.6",
  "description": "WebRPA 启动器",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:1420 && electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build:vite": "vite build",
    "build": "vite build && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^9.2.5",
    "electron": "^42.11.3",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  }
}
